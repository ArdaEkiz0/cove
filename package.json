{
  "name": "cove-tab",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "private": true,
  "author": {
    "name": "DevAnimecx",
    "url": "https://github.com/DevAnimecx"
  },
  "homepage": "https://appcove.vercel.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevAnimecx/cove.git"
  },
  "bugs": {
    "url": "https://github.com/DevAnimecx/cove/issues"
  },
  "description": "Cove — Calm, local-first Manifest V3 New Tab workspace with Midnight Dark spatial stages, ad-free 20+ source RSS newsroom, 0 KB Web Audio neural focus sound, and on-device Markov memory.",
  "keywords": [
    "browser-extension",
    "new-tab",
    "chrome-extension",
    "firefox-addon",
    "manifest-v3",
    "rss-reader",
    "binaural-beats",
    "focus-timer",
    "pomodoro",
    "local-first",
    "privacy-first",
    "svelte5",
    "typescript",
    "web-audio-api",
    "indexeddb",
    "momentum-alternative",
    "zen-browser",
    "brave-browser",
    "productivity",
    "dark-mode"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build && node scripts/package-extensions.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/fuzzy.test.mjs tests/instant-answer.test.mjs tests/markdown.test.mjs tests/moon.test.mjs tests/i18n.test.mjs tests/triage-core.test.mjs tests/defaults.test.mjs tests/rss-parser.test.mjs tests/validation.test.mjs tests/story-id.test.mjs",
    "test:core": "node --test tests/core.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "budget": "node scripts/check-budget.mjs",
    "verify": "node scripts/verify-release.mjs",
    "sync:version": "node scripts/sync-version.mjs",
    "release:check": "npm run typecheck && npm run build && npm test && npm run test:core && npm run verify"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.0.287",
    "open-props": "^1.7.23",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^5.19.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
