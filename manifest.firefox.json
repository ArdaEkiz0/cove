{
  "manifest_version": 3,
  "name": "Cove — Calm New Tab",
  "short_name": "Cove",
  "version": "0.1.2",
  "homepage_url": "https://github.com/DevAnimecx/cove",
  "description": "Your calm corner of the web. Precision typography, on-device ranking, procedural focus soundscapes, and complete full-page settings.",
  "browser_specific_settings": {
    "gecko": {
      "id": "cove@appcove.vercel.app",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "tabGroups",
    "sessions",
    "bookmarks",
    "contextMenus",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "alarms"
  ],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "<all_urls>"
  ],
  "commands": {
    "save-session": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Snapshot open tabs to a Cove session"
    },
    "read-later": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Save active tab to Cove Read Later queue"
    }
  }
}
